<Window x:Class="KeyBeacon.App.Ui.FloatingPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Title="KeyBeacon">
    <Window.Resources>
        <Style x:Key="ModChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style x:Key="ModText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#88FFFFFF" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="#E6202124" Padding="12" SnapsToDevicePixels="True">
        <Grid>
        <StackPanel MinWidth="180"
                    Visibility="{Binding ShowFull, Converter={StaticResource BoolToVisibility}}">
            <!-- Title + state -->
            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StateText}" Foreground="#FFB0B0B0" FontSize="12"
                       Margin="0,2,0,0"
                       Visibility="{Binding StateText, Converter={StaticResource NonEmptyToVisibility}}" />

            <!-- Layer + modifiers (US1) -->
            <StackPanel Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding LayerName}" Foreground="White" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusUpdatedHint}" Style="{StaticResource ModText}"
                               VerticalAlignment="Bottom" Margin="8,0,0,2"
                               Visibility="{Binding StatusStale, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Border Style="{StaticResource ModChip}"
                            Background="{Binding Shift, Converter={StaticResource ActiveToBrush}}">
                        <TextBlock Text="Shift" Foreground="{Binding Shift, Converter={StaticResource ActiveToText}}" FontSize="11" />
                    </Border>
                    <Border Style="{StaticResource ModChip}"
                            Background="{Binding Control, Converter={StaticResource ActiveToBrush}}">
                        <TextBlock Text="Ctrl" Foreground="{Binding Control, Converter={StaticResource ActiveToText}}" FontSize="11" />
                    </Border>
                    <Border Style="{StaticResource ModChip}"
                            Background="{Binding Alt, Converter={StaticResource ActiveToBrush}}">
                        <TextBlock Text="Alt" Foreground="{Binding Alt, Converter={StaticResource ActiveToText}}" FontSize="11" />
                    </Border>
                    <Border Style="{StaticResource ModChip}"
                            Background="{Binding Gui, Converter={StaticResource ActiveToBrush}}">
                        <TextBlock Text="Win" Foreground="{Binding Gui, Converter={StaticResource ActiveToText}}" FontSize="11" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Connectivity (US5) -->
            <ItemsControl ItemsSource="{Binding ConnectivityRows}" Margin="0,8,0,0"
                          Visibility="{Binding ShowConnectivity, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,1">
                            <TextBlock Text="{Binding Label}" Foreground="#FF9A9A9A" FontSize="11" />
                            <TextBlock Text="{Binding Value}" Foreground="#FFE0E0E0" FontSize="11"
                                       HorizontalAlignment="Right" DockPanel.Dock="Right" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Battery (US5) -->
            <ItemsControl ItemsSource="{Binding BatteryRows}" Margin="0,6,0,0"
                          Visibility="{Binding ShowBattery, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,1">
                            <TextBlock Text="{Binding Label}" Foreground="#FF9A9A9A" FontSize="11" />
                            <TextBlock Text="{Binding Value}" Foreground="#FFE0E0E0" FontSize="11"
                                       HorizontalAlignment="Right" DockPanel.Dock="Right" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Compact single-row (mirrors macOS FloatingPanel.compactRow):
             layer + modifier glyphs | host-dot Pn | L/R battery | endpoint -->
        <StackPanel Orientation="Horizontal" MinWidth="120"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding ShowCompact, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding CompactLayer}" Foreground="White"
                       FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,8,0" />

            <!-- Modifier glyphs: always shown, active=white / idle=dim (macOS) -->
            <TextBlock Text="&#x21E7;" FontFamily="Segoe UI Symbol" FontSize="14" Margin="1,0" VerticalAlignment="Center"
                       Foreground="{Binding Shift, Converter={StaticResource ActiveToText}}" />
            <TextBlock Text="&#x2303;" FontFamily="Segoe UI Symbol" FontSize="14" Margin="1,0" VerticalAlignment="Center"
                       Foreground="{Binding Control, Converter={StaticResource ActiveToText}}" />
            <TextBlock Text="&#x2325;" FontFamily="Segoe UI Symbol" FontSize="14" Margin="1,0" VerticalAlignment="Center"
                       Foreground="{Binding Alt, Converter={StaticResource ActiveToText}}" />
            <TextBlock Text="&#x2318;" FontFamily="Segoe UI Symbol" FontSize="14" Margin="1,0" VerticalAlignment="Center"
                       Foreground="{Binding Gui, Converter={StaticResource ActiveToText}}" />

            <!-- Host segment: | dot Pn -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding ShowCompactHost, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="&#x2502;" Foreground="#59FFFFFF" FontSize="13" Margin="8,0" VerticalAlignment="Center" />
                <Ellipse Width="9" Height="9" Margin="0,0,4,0" VerticalAlignment="Center"
                         Fill="{Binding CompactHostDot}"
                         Visibility="{Binding CompactHostDotVisible, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding CompactProfileText}" Foreground="White"
                           FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"
                           Visibility="{Binding CompactProfileVisible, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- Split / battery segment: | dot L85 dot R72 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding ShowCompactSplit, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="&#x2502;" Foreground="#59FFFFFF" FontSize="13" Margin="8,0" VerticalAlignment="Center" />
                <Ellipse Width="8" Height="8" Margin="0,0,3,0" VerticalAlignment="Center" Fill="{Binding CompactLeftDot}" />
                <TextBlock Text="{Binding CompactLeftBattery}" Foreground="White"
                           FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="&#x26A1;" Foreground="#FFCC00" FontSize="11" Margin="2,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding CompactLeftCharging, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding CompactRightVisible, Converter={StaticResource BoolToVisibility}}">
                    <Ellipse Width="8" Height="8" Margin="0,0,3,0" VerticalAlignment="Center" Fill="{Binding CompactRightDot}" />
                    <TextBlock Text="{Binding CompactRightBattery}" Foreground="White"
                               FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="&#x26A1;" Foreground="#FFCC00" FontSize="11" Margin="2,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding CompactRightCharging, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </StackPanel>

            <!-- Output-endpoint segment: | USB -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding ShowCompactEndpoint, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="&#x2502;" Foreground="#59FFFFFF" FontSize="13" Margin="8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CompactEndpointText}" Foreground="White"
                           FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
        </Grid>
    </Border>
</Window>
