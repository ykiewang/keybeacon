<Application x:Class="KeyBeacon.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:KeyBeacon.App.Ui"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ui:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <ui:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility" />
        <ui:ActiveToBrushConverter x:Key="ActiveToBrush" />
        <ui:ActiveToTextConverter x:Key="ActiveToText" />
    </Application.Resources>
</Application>
